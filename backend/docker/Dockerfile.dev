FROM python:3.13-slim-bookworm

WORKDIR /code

# Prevents Python from writing pyc files to disc
ENV PYTHONDONTWRITEBYTECODE=1
# Prevents Python from buffering stdout and stderr
ENV PYTHONUNBUFFERED=1

# Dev-only: always start from a clean, up-to-date schema.
ENV DEBUG=true
ENV RESET_DB=true
ENV SEED_DB=true
ENV AUTH_COOKIE_SECURE=false
ENV REQUIRE_TRUSTED_HOSTS=false

# ARG DEBIAN_FRONTEND=noninteractive

ENV TZ="Europe/Warsaw"

RUN apt-get update
RUN apt-get upgrade -y

RUN apt-get install -y tzdata locales

RUN ln -fs /usr/share/zoneinfo/Europe/Warsaw /etc/localtime

RUN echo "pl_PL.UTF-8 UTF-8" > /etc/locale.gen

RUN locale-gen

RUN apt-get install nano git procps cron curl -y
RUN apt-get install python3-dev gcc gettext -y
RUN apt-get install g++ cmake libbz2-dev libxml2-dev -y
RUN apt-get install pkg-config libxml2-dev libxmlsec1-dev libxmlsec1-openssl -y
RUN apt-get install wget tar -y

# Install OR-Tools C++ to satisfy fzn-cp-sat dynamic dependencies
RUN wget https://github.com/google/or-tools/releases/download/v9.12/or-tools_amd64_debian-12_cpp_v9.12.4544.tar.gz && \
    tar -xvzf or-tools_amd64_debian-12_cpp_v9.12.4544.tar.gz && \
    mv or-tools*/ /opt/or-tools && \
    rm or-tools_amd64_debian-12_cpp_v9.12.4544.tar.gz

ENV LD_LIBRARY_PATH="/opt/or-tools/lib:${LD_LIBRARY_PATH}"

# Install MiniZinc
RUN wget https://github.com/MiniZinc/MiniZincIDE/releases/download/2.9.3/MiniZincIDE-2.9.3-bundle-linux-x86_64.tgz && \
    tar -xvzf MiniZincIDE-2.9.3-bundle-linux-x86_64.tgz && \
    mv MiniZincIDE*/ /opt/minizinc && \
    rm MiniZincIDE-2.9.3-bundle-linux-x86_64.tgz && \
    ln -s /opt/minizinc/bin/minizinc /usr/local/bin/minizinc

ENV PATH="/opt/minizinc/bin:$PATH"

COPY ./pyproject.toml /code/pyproject.toml
COPY ./uv.lock /code/uv.lock

RUN pip install --no-cache-dir uv && uv sync --frozen

ENV PATH="/code/.venv/bin:$PATH"

COPY ./scripts /code/scripts
COPY ./static /code/static
COPY ./app /code/app
COPY ./config /code/config

EXPOSE 80

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "80", "--reload", "--log-config", "/code/config/log.yaml"]