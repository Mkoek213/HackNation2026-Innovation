# Copy to .env at the repository root, fill in FASTINO_API_KEY, then run:
# docker compose up --build -d
# Local development defaults below. Never commit .env.

# Host ports
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432

# PostgreSQL
POSTGRES_DB=radar
POSTGRES_USER=radar
POSTGRES_PASSWORD=password
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Frontend proxy uses the Compose service address; browsers use the host address.
BACKEND_URL=http://backend:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:${BACKEND_PORT}
FRONTEND_BASE_URL=http://localhost:${FRONTEND_PORT}
BACKEND_BASE_URL=http://localhost:${BACKEND_PORT}
# Browser origins allowed by backend CORS and by the Next.js /api/backend BFF.
ALLOWED_HOSTS="[\"http://localhost:${FRONTEND_PORT}\"]"

# Backend
DEBUG=true
RESET_DB=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
AUTH_TOKEN_LOCATION=cookie
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
USE_CSRF_PROTECTION=true
CSRF_HEADER_NAME=X-CSRF-Token
REQUIRE_TRUSTED_HOSTS=false

# Fastino hosted GLiDE
# Paste your Fastino API key here; enables document and conversation topic tagging.
FASTINO_API_KEY=
# Provisional label gates; calibrate on reviewed Polish cases.
TAGGING_MIN_PROBABILITY=0.8
TAGGING_MIN_CONFIDENCE=0.6

# Imported backend authentication secrets
JWT_SECRET=local-development-jwt-secret
CSRF_SECRET=local-development-csrf-secret

# Compose-local Qdrant; use a managed cluster URL and API key for cloud deployments.
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
# Use your team's agreed collection name or your own development collection.
QDRANT_COLLECTION=radar_innovations
# Shared secret for knowledge edits and POST /internal/tagging/sweep (X-Admin-Token); empty disables both.
RADAR_ADMIN_TOKEN=
# Dense embeddings via the Gemini API (GEMINI_API_KEY below); a collection is bound to one model and size.
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=1536
KNOWLEDGE_MAX_UPLOAD_MB=100

# Local private S3-compatible storage (SeaweedFS) for knowledge sources and project PDFs.
# For a backend run on the host (not in Compose), use S3_ENDPOINT_URL=http://localhost:8333.
S3_PORT=8333
S3_ENDPOINT_URL=http://s3:8333
S3_BUCKET=radar-documents
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=radar-local
S3_SECRET_ACCESS_KEY=radar-local-secret

# Contextual Gemini chat (POST /chat and /chat/conversations/...). The key stays backend-only.
GEMINI_API_KEY=
CHAT_GEMINI_MODEL=gemini-3.1-flash-lite
CHAT_GEMINI_API_VERSION=v1beta
CHAT_PROVIDER_TIMEOUT_SECONDS=60
CHAT_TURN_DEADLINE_SECONDS=600
CHAT_INPUT_TOKEN_BUDGET=250000
CHAT_OUTPUT_TOKEN_BUDGET=8192
CHAT_TOOL_CALL_BUDGET=128
CHAT_SOURCE_TIMEOUT_SECONDS=15
CHAT_SOURCE_MAX_BYTES=10000000
# Local HTTP only: false. Use true for HTTPS deployments.
CHAT_OWNER_COOKIE_SECURE=false

# Optional verified staff address for user-reviewed chat email drafts.
# With SMTP configured, contact form messages are also e-mailed here (they are always stored).
RADAR_CONTACT_EMAIL=

# Optional SMTP for server-side PCI handoff with PDF attachment and contact form messages.
# When unset, the UI falls back to download PDF + mailto.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20

# Workspace conversations are topic-tagged once idle this long; the in-process sweep period (0 disables it).
TAGGING_IDLE_SECONDS=300
TAGGING_SWEEP_SECONDS=60
